rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cars sub-collection
      match /cars/{carId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && (!('year' in request.resource.data) || request.resource.data.year == null
              || (request.resource.data.year >= 1968 && request.resource.data.year <= 2030))
          && (!('images' in request.resource.data)
              || request.resource.data.images.size() <= 20);
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && (!('year' in request.resource.data) || request.resource.data.year == null
              || (request.resource.data.year >= 1968 && request.resource.data.year <= 2030))
          && (!('images' in request.resource.data)
              || request.resource.data.images.size() <= 20);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Embeddings sub-collection (writable only by Cloud Functions / admin SDK)
      match /embeddings/{embeddingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only admin SDK (Cloud Functions)
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
